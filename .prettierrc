{
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ],
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "bracketSpacing": true,
  "trailingComma": "es5",
  "semi": true,
  "printWidth": 80,
  "bracketSameLine": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "overrides": [
    {
      "files": [
        "**/*.css",
        "**/*.html"
      ],
      "options": {
        "singleQuote": false
      }
    }
  ],
  "importOrder": [
    "^(react/(.*)$)|^(react$)",
    "<THIRD_PARTY_MODULES>",
    "^@/(.*)",
    "^(?!.*[.]css$)[./].*$",
    ".css$"
  ],
  "importOrderSortSpecifiers": true,
  "importOrderParserPlugins": [
    "typescript",
    "jsx",
    "decorators-legacy"
  ]
}